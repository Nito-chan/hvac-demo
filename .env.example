# ── Demo safety ───────────────────────────────────────────────────────────────
# Optional. Defaults to "demo" which never calls Make.
DEMO_MODE=demo

# ── Lead pipeline ─────────────────────────────────────────────────────────────
# Make.com custom webhook URL for Scenario 1.
MAKE_WEBHOOK_URL=
# Shared secret checked by the webhook filter; sent as x-demo-key.
DEMO_WEBHOOK_KEY=

# ── Optional demo contact overrides ───────────────────────────────────────────
# Public demo numbers only. Leave empty to use the fictional numbers in config.
# India demo phone in E.164 format, e.g. +919XXXXXXXXX
DEMO_PHONE_IN=
# US demo phone in E.164 format (must stay in the reserved 555-01xx range)
DEMO_PHONE_US=

# ── Site ──────────────────────────────────────────────────────────────────────
# Used for absolute URLs in metadata and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
